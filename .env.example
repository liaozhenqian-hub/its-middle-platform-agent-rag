# DeepSeek rewrites conversational questions into structured retrieval queries.
DEEPSEEK_API_KEY=<fill-locally>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_ENABLED=true
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_TIMEOUT_SECONDS=15

# Alibaba Cloud Model Studio / Bailian embedding endpoint.
# It is OpenAI-compatible and exposes /embeddings under this base URL.
EMBEDDING_API_KEY=<fill-locally>
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10

# qwen3-rerank uses the Alibaba key when RERANK_API_KEY is left blank.
RERANK_API_KEY=
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank
RERANK_ENABLED=true
RERANK_TIMEOUT_SECONDS=20
KEYWORD_CANDIDATE_K=20
VECTOR_CANDIDATE_K=20
FINAL_RESULT_K=5

KNOWLEDGE_SOURCE_PATH=D:\javaProgram\metric-platform-knowledge.md
VECTOR_STORE_PATH=D:\javaProgram\its-middle-platform-agent-rag\storage\chroma
CHROMA_COLLECTION_NAME=metric_platform_knowledge

CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=180
BM25_TITLE_WEIGHT=0.65
BM25_KEYWORDS_WEIGHT=0.35

# Application logging: stderr + UTF-8 rotating file.
LOG_LEVEL=INFO
LOG_FILE=logs/knowledge-rag.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Agent model selection is server-controlled; clients cannot override it.
AGENT_MODEL_PROVIDER=openai
AGENT_MODEL_NAME=gpt-5.5
AGENT_OPENAI_API_KEY=<fill-locally>
AGENT_OPENAI_BASE_URL=https://www.codex2api.com/v1
AGENT_MAX_TURNS=12
AGENT_MANAGER_REASONING_ENABLED=true
AGENT_MANAGER_REASONING_TIMEOUT_SECONDS=60
AGENT_INTENT_ROUTER_ENABLED=true
AGENT_INTENT_ROUTER_MIN_CONFIDENCE=0.75
AGENT_DIRECT_SPECIALIST_ENABLED=true
AGENT_COMPOSITE_EVIDENCE_ENABLED=true
AGENT_RETRIEVAL_MAX_CALLS=4
AGENT_RETRIEVAL_MAX_IDENTICAL_QUERIES=1
AGENT_RETRIEVAL_TIMEOUT_SECONDS=20
AGENT_PUBLIC_CITATION_LIMIT=5
AGENT_CITATION_MIN_RERANK_SCORE=0.35
AGENT_CITATION_MIN_RRF_SCORE=0.02

# Conversation history and approval state.
AGENT_SESSION_DB=storage/agent_sessions.db
AGENT_SESSION_HISTORY_LIMIT=50
MEMORY_ENABLED=true
MEMORY_DB=storage/agent_memory.db
MEMORY_MAX_RECALL=5
MEMORY_CANDIDATE_TTL_SECONDS=604800
MEMORY_DEFAULT_RETENTION_DAYS=180
MEMORY_EXTRACTION_ENABLED=true
MEMORY_CHROMA_COLLECTION_NAME=middle_platform_memories
MEMORY_WORKER_ENABLED=true
MEMORY_WORKER_POLL_SECONDS=2
MEMORY_WORKER_STALE_SECONDS=300
MEMORY_AUTO_CONFIRM_SECONDS=86400
MEMORY_MAINTENANCE_INTERVAL_SECONDS=60
MEMORY_PROCEDURAL_GUIDANCE_ENABLED=false
MEMORY_PROCEDURAL_OBSERVE_ONLY=true
MEMORY_PROCEDURAL_RECALL_LIMIT=3
MEMORY_DOMAIN_PROMOTION_ENABLED=false
MEMORY_DOMAIN_DEFAULT_RETENTION_DAYS=90
MEMORY_CONFLICT_REVIEW_THRESHOLD=2
MEMORY_SUMMARY_MAX_CHARS=2000
MEMORY_INCIDENT_CANDIDATE_TTL_SECONDS=604800
MEMORY_ENTITY_RECALL_LIMIT=5
MEMORY_PROCEDURAL_ENABLED=true
AGENT_QUALITY_ENABLED=true
AGENT_QUALITY_DB=storage/agent_quality.db
AGENT_QUALITY_RUNNING_TIMEOUT_SECONDS=600
AGENT_QUALITY_PAGE_SIZE=20
AGENT_QUALITY_SEMANTIC_JUDGE_ENABLED=true
AGENT_QUALITY_JUDGE_MODEL=deepseek-v4-flash
AGENT_QUALITY_JUDGE_TIMEOUT_SECONDS=20
AGENT_QUALITY_EVAL_WORKER_ENABLED=true
AGENT_QUALITY_SCHEDULED_EVAL_ENABLED=true
AGENT_QUALITY_EVAL_POLL_SECONDS=2
AGENT_QUALITY_EVAL_STALE_SECONDS=300
AGENT_QUALITY_EVAL_CASE_TIMEOUT_SECONDS=120
AGENT_APPLICATION_VERSION=0.1.0
AGENT_PROMPT_VERSION=v1

# Traces exclude prompts, tool payloads, and model content by default.
AGENT_TRACING_ENABLED=true
AGENT_TRACE_INCLUDE_SENSITIVE_DATA=false
AGENT_TRACING_API_KEY=

# Feishu application bot long connection. Rotate exposed credentials before use.
FEISHU_BOT_ENABLED=false
FEISHU_APP_ID=<fill-locally>
FEISHU_APP_SECRET=<fill-locally>
FEISHU_EVENT_DB=storage/feishu_bot.db
FEISHU_REPLY_MAX_CHARS=3500
FEISHU_GROUP_REQUIRE_MENTION=true
FEISHU_THREAD_ISOLATION_ENABLED=true
FEISHU_AGENT_TIMEOUT_SECONDS=180

# Optional web identity. Anonymous device chat remains available when OAuth is off.
USER_AUTH_ENABLED=true
USER_AUTH_DB=storage/user_auth.db
USER_PUBLIC_BASE_URL=http://172.18.26.1:8000
FEISHU_OAUTH_ENABLED=true
# Optional dedicated web-login application. When both values are blank,
# OAuth falls back to FEISHU_APP_ID/FEISHU_APP_SECRET for compatibility.
FEISHU_OAUTH_APP_ID=<fill-locally>
FEISHU_OAUTH_APP_SECRET=<fill-locally>
# Optional: set to restrict login to one Feishu tenant; blank accepts every user authorized by the app.
FEISHU_TENANT_KEY=
ANONYMOUS_COOKIE_NAME=knowledge_anon
ANONYMOUS_DEVICE_TTL_SECONDS=15552000
USER_SESSION_COOKIE_NAME=knowledge_user
USER_SESSION_SLIDING_TTL_SECONDS=604800
USER_SESSION_ABSOLUTE_TTL_SECONDS=2592000
OAUTH_STATE_TTL_SECONDS=600
USER_COOKIE_SECURE=false

# Read-only metric platform MCP. Rotate any credential shared outside secret storage.
METRIC_MCP_ENABLED=true
METRIC_QUERY_GUARD_ENABLED=true
METRIC_MCP_URL=http://127.0.0.1:8080/mcp/messages
METRIC_MCP_BEARER_TOKEN=<fill-locally>
METRIC_MCP_TIMEOUT_SECONDS=30

# Read-only middle-platform Grafana/Loki trace lookup. All target identifiers
# are server-owned; the Agent cannot supply arbitrary URLs or LogQL queries.
GRAFANA_LOG_ENABLED=false
GRAFANA_LOG_URL=
GRAFANA_LOG_BEARER_TOKEN=<fill-locally>
GRAFANA_LOG_TIMEOUT_SECONDS=15
GRAFANA_LOG_MAX_ENTRIES=20
GRAFANA_LOG_MAX_ENTRY_CHARS=2000
GRAFANA_LOG_MAX_TOTAL_CHARS=30000
GRAFANA_LOG_MAX_RANGE_MINUTES=1440
GRAFANA_LOG_APP_LABEL=api-center-server
GRAFANA_LOG_QUERY_MAX_LINES=1000
GRAFANA_DEVELOP_DATASOURCE_UID=
GRAFANA_DEVELOP_NAMESPACE=api-center-develop
GRAFANA_DEVELOP_CODE_BRANCH=develop
GRAFANA_TEST_DATASOURCE_UID=
GRAFANA_TEST_NAMESPACE=api-center-release
GRAFANA_TEST_CODE_BRANCH=develop
GRAFANA_PROD_DATASOURCE_UID=
GRAFANA_PROD_NAMESPACE=api-center-master
GRAFANA_PROD_CODE_BRANCH=master

# Deterministic LangGraph Bug diagnosis workflow.
BUG_GRAPH_ENABLED=true
BUG_GRAPH_CHECKPOINT_PROVIDER=auto
BUG_GRAPH_DB=storage/bug_graph.db
BUG_GRAPH_INTERRUPT_TTL_SECONDS=86400
BUG_GRAPH_LOG_RETRY_COUNT=2
BUG_GRAPH_LOG_RANGE_MINUTES=1440
BUG_GRAPH_CODE_TOP_K=5
BUG_GRAPH_MIN_RERANK_SCORE=0.35
CITATION_DETAIL_MAX_CHARS=6000

# Knowledge-source catalog and local storage. Relative paths resolve from the
# project root.
KNOWLEDGE_CATALOG_DB=storage/knowledge_catalog.db
KNOWLEDGE_STORAGE_ROOT=storage
FRONTEND_DIST=web/dist

# Persistence migration switches. Keep the local providers until PostgreSQL
# and pgvector have passed migration and shadow-query verification.
DATA_STORE_PROVIDER=sqlite
VECTOR_STORE_PROVIDER=chroma
RETRIEVAL_WARMUP_ENABLED=true
# Prefer a platform-injected secret in dev. Do not commit a real DSN.
# Target database: middle_agent
DATABASE_URL=
DATABASE_SSL_MODE=prefer
# Split variables are also supported by the migration probe and avoid URL
# encoding mistakes in passwords. Production should inject these as Secrets.
PGHOST=
PGPORT=5432
PGDATABASE=middle_agent
PGUSER=
PGPASSWORD=
DATABASE_SCHEMA=public
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_PRE_PING=true
PGVECTOR_POOL_MAX_IDLE_SECONDS=300
DATABASE_STATEMENT_TIMEOUT_SECONDS=30
DATABASE_MIGRATION_BATCH_SIZE=5000
VECTOR_SHADOW_ENABLED=false
VECTOR_SHADOW_SAMPLE_RATE=1.0
PGVECTOR_SCHEMA=public
PGVECTOR_TABLE=vector_entries
PGVECTOR_BATCH_SIZE=500
PGVECTOR_HNSW_EF_SEARCH=100

# GitLab discovery and repository synchronization. Use a group/project access
# token limited to read_api + read_repository. Never put the token in a clone URL.
GITLAB_BASE_URL=
GITLAB_ACCESS_TOKEN=<fill-locally>
GIT_SYNC_INTERVAL_SECONDS=600
GIT_COMMAND_TIMEOUT_SECONDS=1800
SOURCE_WORKER_ENABLED=true
SOURCE_WORKER_POLL_SECONDS=2
SOURCE_WORKER_STALE_SECONDS=900

# Encrypts reversible Swagger credentials in SQLite. Git Webhook secrets are
# stored only as SHA-256 hashes and do not use this key.
# Generate a URL-safe base64 string that decodes to exactly 32 random bytes.
KNOWLEDGE_SECRET_MASTER_KEY=<fill-locally>

# Shared administrator account. Generate the Argon2 value with:
# python -m knowledge.cli hash-admin-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_NAME=knowledge_admin
# Keep false for local HTTP; production HTTPS must set this to true.
ADMIN_COOKIE_SECURE=false

# Comma-separated hostnames only, without scheme, port, path, or wildcard.
SWAGGER_ALLOWED_HOSTS=

# Upload limits: 50 MiB per file, 500 MiB per batch, at most 2,000 files.
UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_MAX_BATCH_BYTES=524288000
UPLOAD_MAX_FILES=2000
